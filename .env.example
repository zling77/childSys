# Child psychology previsit demo local config.
# Copy this file to .env, then set PREVISIT_LLM_API_KEY only in that local file.

# DeepSeek API dynamic follow-up mode
PREVISIT_LLM_MODE=dynamic
PREVISIT_LLM_PROVIDER=openai_compatible

# Leave the SSH host empty so npm run dev does not start the Ollama tunnel.
PREVISIT_OLLAMA_SSH_HOST=
PREVISIT_OLLAMA_TUNNEL_LOCAL_PORT=11435
PREVISIT_OLLAMA_REMOTE_PORT=11434
PREVISIT_LLM_BASE_URL=https://api.deepseek.com
PREVISIT_LLM_API_KEY=replace-with-your-deepseek-api-key
PREVISIT_LLM_MODEL=deepseek-v4-pro
PREVISIT_LLM_CLARIFY_MODEL=deepseek-v4-pro
PREVISIT_LLM_THINKING=disabled

PREVISIT_LLM_TIMEOUT_MS=30000
PREVISIT_LLM_CLARIFY_TIMEOUT_MS=20000
PREVISIT_LLM_RETRY_ATTEMPTS=1
PREVISIT_LLM_TEMPERATURE=0.2
PREVISIT_LLM_MAX_TOKENS=700

# Remote Ollama alternative through a001-4:
# PREVISIT_OLLAMA_SSH_HOST=a001-4
# PREVISIT_LLM_BASE_URL=http://127.0.0.1:11435/v1
# PREVISIT_LLM_API_KEY=ollama
# PREVISIT_LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# PREVISIT_LLM_CLARIFY_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# PREVISIT_LLM_THINKING=

# To turn off LLM calls temporarily:
# PREVISIT_LLM_MODE=off

# Optional local paths/ports
# HOST=127.0.0.1
# PORT=4176
# PREVISIT_DB_PATH=server/data/previsit.db
# PREVISIT_MEDIA_ROOT=server/data/media

# Neural Chinese narration (browser speech is only the fallback)
# Use the Python executable with requirements-tts.txt installed, or its absolute path.
PREVISIT_TTS_PYTHON=python
PREVISIT_TTS_VOICE=zh-CN-XiaoxiaoNeural

# Independent clinician evidence extraction / relation candidates / doctor wording.
# Tested local server: a001-1-cpolar, Ollama qwen3.5:9b (Q4_K_M).
# This setting is independent of PREVISIT_LLM_MODE for guardian/child intake.
PREVISIT_CLINICIAN_LLM_MODE=off
PREVISIT_CLINICIAN_LLM_BASE_URL=http://127.0.0.1:11435
PREVISIT_CLINICIAN_LLM_MODEL=qwen3.5:9b
PREVISIT_CLINICIAN_LLM_TIMEOUT_MS=180000
PREVISIT_CLINICIAN_LLM_NUM_CTX=16384
# To enable: set clinician mode to on and PREVISIT_OLLAMA_SSH_HOST=a001-1-cpolar.
# Optional separate model names: PREVISIT_CLINICIAN_LLM_EXTRACT_MODEL,
# PREVISIT_CLINICIAN_LLM_RELATION_MODEL, PREVISIT_CLINICIAN_LLM_EXPRESSION_MODEL.
